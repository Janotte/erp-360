    }
  },
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "devDependencies": {
    "@erp-360/eslint-config": "workspace:*",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.7",
    "turbo": "^2.10.13",
    "typescript": "~6.0.2",
    "wait-on": "^9.1.0"
  }
