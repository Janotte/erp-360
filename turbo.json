{
  "$schema": "https://turbo.build",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vite/**"]
    },
    "db:setup": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^db:setup"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true
    },
    "format": {
      "cache": true
    }
  }
}
