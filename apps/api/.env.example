# ENVIRONMENT DEVELOPMENT
# ============================================
NODE_ENV=development
APP_NAME=erp-360-api
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=3000

# Opcional: duplicar logs (JSON) para ficheiro; consola mantém o comportamento atual (pretty em dev, JSON em prod).
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# DATABASE
# ============================================
# Gerar: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=erp360_db
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 1d = 1 dia
JWT_EXPIRES_IN=1d

# Cifra a senha do certificado A1. Tem de ser diferente do JWT_SECRET.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERTIFICATE_SECRET=

# Origens do navegador autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
